{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "generator": "Visual Studio 17 2022",
      "binaryDir": "${sourceDir}/build/windows-vs2022",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_CXX_STANDARD": "20"
      }
    },
    {
      "name": "windows-vs2022-tests",
      "inherits": "windows-vs2022",
      "binaryDir": "${sourceDir}/build/windows-vs2022-tests",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug"
    },
    {
      "name": "windows-vs2022-tests-debug",
      "configurePreset": "windows-vs2022-tests",
      "configuration": "Debug"
    }
  ]
}